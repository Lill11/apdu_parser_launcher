QWidget {
    color: #0F172A;
    font-family: "Segoe UI";
    font-size: 13px;
}

QMainWindow, QWidget#centralwidget, QWidget {
    background: #F4F6F8;
}

QLabel {
    background: transparent;
}

QMainWindow, QSplitter, QSplitter::handle {
    background: #F4F6F8;
}

QFrame#card, QFrame#dropZone, QFrame#summaryCard {
    background: #FFFFFF;
    border: 1px solid #D9E1EA;
    border-radius: 14px;
}

QFrame#stateCard {
    background: #FFFFFF;
    border: 1px solid #D9E1EA;
    border-radius: 16px;
    min-width: 400px;
    max-width: 560px;
}

QFrame#dropZone[dragActive="true"] {
    border: 2px solid #2563EB;
    background: #EAF2FF;
}

QLabel#appTitle {
    font-size: 26px;
    font-weight: 700;
    color: #0F172A;
}

QLabel#appSubtitle, QLabel#secondaryText, QLabel#errorSummary {
    color: #5B687A;
}

QLabel#selectionTitle {
    font-size: 17px;
    font-weight: 700;
    color: #0F172A;
}

QLabel#dropZoneTitle {
    font-size: 16px;
    font-weight: 600;
}

QLabel#dropZoneSubtitle {
    color: #5B687A;
}

QLabel#panelTitle {
    font-size: 18px;
    font-weight: 700;
}

QLabel#stateIcon {
    min-width: 36px;
    min-height: 36px;
    max-width: 36px;
    max-height: 36px;
    border-radius: 18px;
    background: #EAF2FF;
    color: #2563EB;
    font-size: 18px;
    font-weight: 700;
}

QLabel#stateTitle {
    font-size: 18px;
    font-weight: 700;
    color: #0F172A;
}

QLabel#stateMessage {
    color: #334155;
    font-size: 13px;
}

QLabel#stateHint {
    color: #64748B;
    font-size: 12px;
}

QPushButton {
    background: #FFFFFF;
    border: 1px solid #D9E1EA;
    border-radius: 10px;
    padding: 8px 14px;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    border-color: #2563EB;
}

QPushButton:pressed {
    background: #EAF2FF;
}

QPushButton:disabled {
    color: #94A3B8;
    border-color: #E2E8F0;
}

QPushButton#primaryButton {
    background: #2563EB;
    color: white;
    border: 1px solid #1D4ED8;
}

QPushButton#primaryButton:hover {
    background: #1D4ED8;
}

QPushButton#filterChip {
    padding: 6px 14px;
    border-radius: 999px;
    background: #FFFFFF;
    min-width: 0;
}

QPushButton#filterChip:checked {
    background: #2563EB;
    color: white;
    border-color: #1D4ED8;
}

QPushButton#linkButton {
    border: none;
    background: transparent;
    color: #64748B;
    padding: 2px 4px;
    min-height: 0;
}

QPushButton#linkButton:hover {
    color: #2563EB;
    border: none;
}

QHeaderView::section {
    background: #F8FAFC;
    color: #5B687A;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #D9E1EA;
    padding: 8px 10px;
}

QTableView, QTreeWidget, QTextBrowser, QPlainTextEdit, QLineEdit, QTabWidget::pane {
    background: #FFFFFF;
    border: 1px solid #D9E1EA;
    border-radius: 12px;
}

QTableView {
    selection-background-color: #EAF2FF;
    selection-color: #0F172A;
    gridline-color: transparent;
    border-radius: 14px;
}

QTableView::item, QTreeWidget::item {
    padding: 8px;
}

QTableView#logTable::item:selected {
    background: #EAF2FF;
    color: #0F172A;
}

QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 12px;
    margin-right: 8px;
    color: #64748B;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #2563EB;
    border-bottom: 2px solid #2563EB;
}

QLineEdit {
    padding: 8px 12px;
}
